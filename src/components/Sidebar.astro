---
interface Props {
	tags: string[];
	lang?: 'sk' | 'en';
}

const { tags, lang = 'sk' } = Astro.props;
const isEnglish = lang === 'en';
const blogPrefix = isEnglish ? '/en' : '';
const bioTitle = isEnglish ? 'Technology, AI and data sovereignty.' : 'Technológie, AI a dátová suverenita.';
const bio = isEnglish
	? 'First, data — its identification and classification, private and public. I always start system design from that; everything else is composition, using what exists or building it when needed.'
	: 'Najprv dáta — ich identifikácia a klasifikácia, súkromné a verejné. Z nich pri návrhu systému vždy vychádzam; zvyšok je už skladanie existujúcich dielov, alebo stavba vlastných.';
---

<aside class="sidebar">
	<div class="profile">
		<img
			class="avatar"
			src="/frantisek-web.jpg"
			alt="František Bolgáč"
			width="108"
			height="108"
		/>
		<p class="name">František Bolgáč</p>
		<p class="bio-title">{bioTitle}</p>
		<p class="bio">{bio}</p>
	</div>

	{
		tags.length > 0 && (
			<div class="tags">
				<p class="tags-title">{isEnglish ? 'Topics' : 'Tagy'}</p>
				<ul>
					{tags.map((tag) => (
						<li>
							<a href={`${blogPrefix}/blog/tag/${tag}`}>#{tag}</a>
						</li>
					))}
				</ul>
			</div>
		)
	}
</aside>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.avatar {
		display: block;
		width: 6.75rem;
		height: 6.75rem;
		border-radius: 50%;
		object-fit: cover;
		margin: 0 auto 1rem;
	}
	.name {
		font-weight: 700;
		font-size: 1.125rem;
		margin: 0 0 0.5rem;
	}
	.bio-title {
		margin: 0 0 0.5rem;
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 600;
	}
	.bio {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.tags-title {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--muted);
		margin: 0 0 0.5rem;
	}
	.tags ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}
	.tags a {
		font-size: 0.85rem;
		color: var(--muted);
		text-decoration: none;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.125rem 0.625rem;
	}
	.tags a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
</style>
