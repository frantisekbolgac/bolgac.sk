---
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';

interface Props {
	title: string;
	description?: string;
	lang?: 'sk' | 'en';
	ogType?: 'website' | 'article';
}

const { title, description = 'Bolgac — blog', lang = 'sk', ogType = 'website' } = Astro.props;
const path = Astro.url.pathname;
const isEnglish = lang === 'en';
const homePath = isEnglish ? '/en/' : '/';
const blogPath = isEnglish ? '/en/blog/' : '/blog/';
const aboutPath = isEnglish ? '/en/about/' : '/o-mne/';
const isHome = isEnglish ? path === '/en/' || path === '/en' : path === '/';

function withTrailingSlash(pathname: string) {
	return pathname.endsWith('/') ? pathname : `${pathname}/`;
}

function toLanguagePath(pathname: string, language: 'sk' | 'en') {
	const normalized = pathname === '' ? '/' : pathname;

	if (language === 'en') {
		if (normalized === '/') return '/en/';
		if (normalized === '/o-mne' || normalized === '/o-mne/') return '/en/about/';
		return withTrailingSlash(`/en${normalized.startsWith('/en') ? normalized.slice(3) : normalized}`);
	}

	if (normalized === '/en' || normalized === '/en/') return '/';
	if (normalized === '/en/about' || normalized === '/en/about/') return '/o-mne/';
	return withTrailingSlash(normalized.replace(/^\/en/, ''));
}

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(withTrailingSlash(path), siteUrl);
const skUrl = new URL(toLanguagePath(path, 'sk'), siteUrl);
const enUrl = new URL(toLanguagePath(path, 'en'), siteUrl);
const locale = isEnglish ? 'en_US' : 'sk_SK';
const alternateLocale = isEnglish ? 'sk_SK' : 'en_US';
const languagePath = toLanguagePath(path, isEnglish ? 'sk' : 'en');
const languageLabel = isEnglish ? 'Switch to Slovak' : 'Switch to English';
const languageHreflang = isEnglish ? 'sk' : 'en';

const posts = isEnglish
	? await getCollection('blogEn', ({ data }) => !data.draft)
	: await getCollection('blog', ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="bolgac.sk" />
		<meta property="og:locale" content={locale} />
		<meta property="og:locale:alternate" content={alternateLocale} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="sk" href={skUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={skUrl} />
		<script is:inline>
			// No-FOUC: téma sa aplikuje skôr, než sa vykreslí čokoľvek.
			// Preto inline v <head>, nie externý súbor (ten by prišiel neskoro
			// a stránka by na zlomok sekundy blikla do svetlej témy).
			const t = localStorage.getItem('theme');
			if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.dataset.theme = 'dark';
			}
		</script>
		<style>
			/* Paleta A — "Navy & Paper". Všetky farby cez premenné,
			   dark režim len prepíše hodnoty — žiadne duplicitné štýly. */
			:root {
				--bg: #faf9f7;
				--text: #1c1917;
				--muted: #78716c;
				--accent: #1e3a5f;
				--border: #e7e5e4;
				--code-bg: #f1efec;
			}
			:root[data-theme='dark'] {
				--bg: #0f1216;
				--text: #e8e6e3;
				--muted: #8a8f98;
				--accent: #7aa2cc;
				--border: #242a32;
				--code-bg: #1a2029;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
				background: var(--bg);
				color: var(--text);
				line-height: 1.7;
			}
			.container {
				max-width: 64rem;
				margin: 0 auto;
				padding: 0 1.25rem 2rem;
			}
			.topbar {
				position: sticky;
				top: 0;
				z-index: 10;
				background: color-mix(in srgb, var(--bg) 88%, transparent);
				backdrop-filter: blur(8px);
				border-bottom: 1px solid var(--border);
				margin: 0 -1.25rem 2rem;
				padding: 0.75rem 1.25rem;
			}
			.topbar-inner {
				max-width: 64rem;
				margin: 0 auto;
				display: flex;
				align-items: center;
				gap: 1.5rem;
				flex-wrap: wrap;
				row-gap: 0.5rem;
			}
			.brand {
				font-weight: 700;
				color: var(--text);
				text-decoration: none;
			}
			.topnav {
				display: flex;
				gap: 1.25rem;
				flex-wrap: wrap;
			}
			.topnav a {
				color: var(--muted);
				text-decoration: none;
			}
			.topnav a:hover {
				color: var(--accent);
			}
			.topnav a.active {
				color: var(--accent);
				font-weight: 600;
			}
			.controls {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-left: auto;
			}
			.language-link {
				color: var(--muted);
				font-size: 0.85rem;
				text-decoration: none;
			}
			.language-link:hover {
				color: var(--accent);
			}
			.theme-toggle {
				background: none;
				border: 1px solid var(--border);
				border-radius: 0.375rem;
				color: var(--muted);
				cursor: pointer;
				font-size: 1rem;
				line-height: 1;
				padding: 0.375rem 0.5rem;
			}
			.theme-toggle:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.layout {
				display: grid;
				grid-template-columns: 15rem 1fr;
				gap: 3rem;
				align-items: start;
			}
			.sidebar-wrap {
				position: sticky;
				top: 4.5rem;
			}
			/* Mobil: sidebar sa zbalí nad obsah */
			@media (max-width: 48rem) {
				.layout {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.sidebar-wrap {
					position: static;
				}
			}
			footer {
				margin-top: 4rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border);
				color: var(--muted);
				font-size: 0.875rem;
			}
			h1,
			h2,
			h3 {
				line-height: 1.3;
			}
			a {
				color: var(--accent);
			}
			pre,
			code {
				font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
			}
			pre {
				background: var(--code-bg);
				border: 1px solid var(--border);
				border-radius: 0.5rem;
				padding: 1rem;
				overflow-x: auto;
			}
			:not(pre) > code {
				background: var(--code-bg);
				border-radius: 0.25rem;
				padding: 0.125rem 0.375rem;
				font-size: 0.9em;
			}
			:global(table) {
				display: block;
				width: 100%;
				margin: 1.5rem 0;
				border-collapse: collapse;
				border-top: 1px solid color-mix(in srgb, var(--muted) 50%, var(--border));
				overflow-x: auto;
			}
			:global(th),
			:global(td) {
				padding: 0.75rem 0.625rem;
				border-bottom: 1px solid color-mix(in srgb, var(--muted) 50%, var(--border));
				text-align: left;
				vertical-align: top;
			}
			:global(th) {
				color: var(--muted);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
		</style>
	</head>
	<body>
		<header class="topbar">
			<div class="topbar-inner">
				<a class="brand" href={homePath}>bolgac.sk</a>
				<nav class="topnav" aria-label={isEnglish ? 'Main navigation' : 'Hlavná navigácia'}>
					<a href={homePath} class:list={[{ active: isHome }]}>{isEnglish ? 'Home' : 'Domov'}</a>
					<a href={blogPath} class:list={[{ active: path.startsWith(isEnglish ? '/en/blog' : '/blog') }]}>Blog</a>
					<a href={aboutPath} class:list={[{ active: path.startsWith(isEnglish ? '/en/about' : '/o-mne') }]}>
						{isEnglish ? 'About' : 'O mne'}
					</a>
				</nav>
				<div class="controls">
					<a
						class="language-link"
						href={languagePath}
						hreflang={languageHreflang}
						aria-label={languageLabel}
					>
						{isEnglish ? 'SK' : 'EN'}
					</a>
					<button class="theme-toggle" id="theme-toggle" aria-label={isEnglish ? 'Toggle theme' : 'Prepnúť tému'}>◐</button>
				</div>

			</div>
		</header>
		<div class="container">
			<div class="layout">
				<div class="sidebar-wrap">
					<Sidebar tags={tags} lang={lang} />
				</div>
				<main>
					<slot />
				</main>
			</div>
			<footer>
				© {new Date().getFullYear()} bolgac.sk
			</footer>
		</div>
		<script>
			// Prepínač témy: prepíše data-theme + persistuje do localStorage.
			// Beží na klientovi až po načítaní (nie pri builde).
			const btn = document.getElementById('theme-toggle');
			btn?.addEventListener('click', () => {
				const root = document.documentElement;
				const dark = root.dataset.theme === 'dark';
				if (dark) {
					delete root.dataset.theme;
					localStorage.setItem('theme', 'light');
				} else {
					root.dataset.theme = 'dark';
					localStorage.setItem('theme', 'dark');
				}
			});
		</script>
	</body>
</html>
