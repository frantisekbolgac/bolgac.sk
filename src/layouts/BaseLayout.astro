---
interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Bolgac — blog' } = Astro.props;
---

<!doctype html>
<html lang="sk">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style>
			:root {
				--bg: #fafaf9;
				--text: #1c1917;
				--muted: #78716c;
				--accent: #0f766e;
				--border: #e7e5e4;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: system-ui, -apple-system, sans-serif;
				background: var(--bg);
				color: var(--text);
				line-height: 1.7;
			}
			.container {
				max-width: 42rem;
				margin: 0 auto;
				padding: 2rem 1.25rem;
			}
			header nav {
				display: flex;
				gap: 1.5rem;
				align-items: baseline;
				margin-bottom: 3rem;
			}
			header a {
				color: inherit;
				text-decoration: none;
				font-weight: 600;
			}
			header nav a:not(:first-child) {
				font-weight: 400;
				color: var(--muted);
			}
			header nav a:not(:first-child):hover {
				color: var(--accent);
			}
			footer {
				margin-top: 4rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border);
				color: var(--muted);
				font-size: 0.875rem;
			}
			h1,
			h2,
			h3 {
				line-height: 1.3;
			}
			a {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<div class="container">
			<header>
				<nav>
					<a href="/">bolgac.sk</a>
					<a href="/blog">blog</a>
				</nav>
			</header>
			<main>
				<slot />
			</main>
			<footer>
				© {new Date().getFullYear()} bolgac.sk
			</footer>
		</div>
	</body>
</html>
