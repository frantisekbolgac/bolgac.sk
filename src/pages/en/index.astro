---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogEn', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
	lang="en"
	title="František Bolgáč — technology, AI and data sovereignty"
	description="František Bolgáč's blog about technology, AI and data sovereignty."
>
	<section class="intro">
		<p class="eyebrow">František Bolgáč</p>
		<h1>Technology, AI and data sovereignty.</h1>
		<p class="lead">
			I write about technology that makes sense in practice. No buzzwords, with a focus on
			data sovereignty.
		</p>
	</section>

	<section class="archive">
		<div class="post-list">
			{
				posts.map((post) => (
					<article class="post">
						<time datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString('en-GB')}
						</time>
						<h2><a href={`/en/blog/${post.id}/`}>{post.data.title}</a></h2>
						{post.data.description && <p>{post.data.description}</p>}
						{post.data.tags.length > 0 && (
							<div class="post-tags">
								{post.data.tags.map((tag) => (
									<a href={`/en/blog/tag/${tag}/`}>#{tag}</a>
								))}
							</div>
						)}
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		padding: 1rem 0 2.5rem;
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		max-width: none;
		margin: 0;
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		letter-spacing: -0.04em;
	}
	.lead {
		max-width: 40rem;
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 1.125rem;
	}
	.archive {
		border-top: 1px solid var(--border);
		padding-top: 0.5rem;
	}
	.post-list {
		border-top: 1px solid var(--border);
	}
	.post {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}
	.post time {
		color: var(--muted);
		font-size: 0.875rem;
	}
	.post h2 {
		margin: 0.35rem 0 0;
		font-size: 1.25rem;
	}
	.post h2 a {
		text-decoration: none;
	}
	.post h2 a:hover {
		text-decoration: underline;
	}
	.post p {
		max-width: 42rem;
		margin: 0.5rem 0 0;
		color: var(--muted);
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: 0.75rem;
	}
	.post-tags a {
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.8rem;
		text-decoration: none;
	}
	.post-tags a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
